#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        braces: braces {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACES";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;

            tapping-term-ms = <200>;
        };

        brackets: brackets {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;

            tapping-term-ms = <200>;
        };

        plusmin: plusmin {
            compatible = "zmk,behavior-tap-dance";
            label = "PLUSMIN";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp MINUS>;

            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE  &kp N1       &kp N2            &kp N3          &kp N4          &kp N5  &tog 4                                                                           &mo 5                &kp N6  &kp N7           &kp N8               &kp N9               &kp N0          &kp MINUS
&kp TAB     &kp Q        &kp W             &kp E           &kp R           &kp T   &kp LS(LC(LA(LEFT_SHIFT)))                                                       &kp LS(LC(LA(F11)))  &kp Y   &kp U            &kp I                &kp O                &kp P           &kp SINGLE_QUOTE
&braces     &kp A        &kp S             &kp D           &kp F           &kp G   &kp F2                      &kp LCTRL   &kp LALT            &kp LGUI  &kp RCTRL  &kp LS(LC(LA(F12)))  &kp H   &kp J            &kp K                &kp L                &kp SEMI        &kp EQUAL
&brackets   &hm LCTRL Z  &hm LEFT_SHIFT X  &hm LEFT_ALT C  &hm LEFT_WIN V  &kp B                                           &kp HOME            &kp DEL                                   &kp N   &hm RIGHT_WIN M  &hm RIGHT_ALT COMMA  &hm RIGHT_SHIFT DOT  &hm RCTRL FSLH  &kp BACKSLASH
&kp LCTRL   &none        &none             &kp LEFT        &kp RIGHT               &kp SPACE                   &kp ESCAPE  &kp LEFT_SHIFT      &mo 1     &kp ENTER  &kp BACKSPACE                &kp DOWN_ARROW   &kp UP_ARROW         &kp LBKT             &kp RBKT        &to 3
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1         &kp F2            &kp F2                &kp F3                 &kp F5             &kp F6       &tog 4                                                             &mo 5            &kp F7     &kp F8            &kp F9             &kp F10     &kp F11       &kp F12
&kp TAB        &kp N1            &kp N2                &kp N3                 &kp N4             &kp N5       &kp MINUS                                                          &none            &kp N6     &kp N7            &kp N8             &kp N9      &kp N0        &kp SINGLE_QUOTE
&kp AMPERSAND  &kp LEFT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp RIGHT_BRACKET  &kp PERCENT  &kp PLUS   &kp LCTRL  &kp LALT            &kp LEFT_GUI  &kp RCTRL  &kp PRINTSCREEN  &kp CARET  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp DOLLAR  &kp COLON     &kp EQUAL
&kp POUND      &kp LESS_THAN     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GREATER_THAN   &kp PIPE                           &kp MINUS           &kp DEL                                   &kp ASTRK  &kp GRAVE         &kp COMMA          &kp DOT     &kp QUESTION  &kp BACKSLASH
&kp LCTRL      &kp AMPERSAND     &kp TILDE             &kp LEFT               &kp RIGHT                       &kp SPACE  &kp UNDER  &kp LEFT_SHIFT      &none         &kp RET    &kp BSPC                    &kp DOWN          &kp UP_ARROW       &kp PLUS    &kp MINUS     &kp PERCENT
            >;
        };

        numbers {
            bindings = <
&kp F1     &kp F2        &kp F3      &kp F4         &kp F5        &kp F6         &kp F7                                                     &kp F8     &kp F7         &kp F8        &kp F9     &kp F10    &kp F11      &kp F12
&trans     &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)  &trans                                                     &trans     &kp LS(CARET)  &kp LS(AMPS)  &kp PLUS   &kp MINUS  &kp PERCENT  &kp SINGLE_QUOTE
&kp PG_DN  &kp N1        &kp N2      &kp N3         &kp N4        &kp N5         &trans     &trans  &trans         &kp LEFT_GUI  &trans     &kp ASTRK  &kp N6         &kp N7        &kp N8     &kp N9     &kp N0       &kp EQUAL
&trans     &kp LCTRL     &kp LSHFT   &kp LALT       &kp LGUI      &trans                            &trans         &kp DEL                             &kp PLUS       &kp MINUS     &kp COMMA  &kp DOT    &kp FSLH     &kp STAR
&trans     &trans        &trans      &kp LEFT       &kp RIGHT                    &kp SPACE  &to 0   &kp LSHFT      &to 1         &kp ENTER  &kp BSPC                  &kp DOWN      &kp UP     &kp LALT   &kp LSHFT    &kp LCTRL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans              &trans              &trans              &trans              &trans              &trans                                      &trans  &trans              &trans              &trans              &trans              &trans               &trans
&trans  &kp LS(LC(LA(F1)))  &kp LS(LC(LA(F2)))  &kp LS(LC(LA(F3)))  &kp LS(LC(LA(F4)))  &kp LS(LC(LA(F5)))  &trans                                      &trans  &kp LS(LC(LA(F6)))  &kp LS(LC(LA(F7)))  &kp LS(LC(LA(F8)))  &kp LS(LC(LA(F9)))  &kp LS(LC(LA(F10)))  &trans
&trans  &kp LS(LC(LA(N1)))  &kp LS(LC(LA(N2)))  &kp LS(LC(LA(N3)))  &kp LS(LC(LA(N4)))  &kp LS(LC(LA(N5)))  &trans  &trans  &trans      &trans  &trans  &trans  &kp LS(LC(LA(N6)))  &kp LS(LC(LA(N7)))  &kp LS(LC(LA(N8)))  &kp LS(LC(LA(N9)))  &kp LS(LC(LA(N0)))   &trans
&trans  &trans              &trans              &trans              &trans              &trans                              &trans      &trans                  &trans              &trans              &trans              &trans              &trans               &trans
&trans  &trans              &trans              &trans              &trans                                  &trans  &to 0   &trans      &trans  &trans  &trans                      &trans              &trans              &trans              &trans               &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp ESCAPE  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                    &mo 5          &kp N6           &kp KP_NUM      &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB     &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                     &none          &kp Y            &kp KP_N7       &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC     &kp A      &kp S     &kp D     &kp F      &kp G   &none      &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none          &kp H            &kp KP_N4       &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp EQUAL
&kp LSHFT   &kp Z      &kp X     &kp C     &kp V      &kp B                         &kp HOME      &kp DEL                              &kp KP_NUMBER_0  &kp KP_N1       &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &none
&none       &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp SPACE  &to 0      &kp END       &kp PG_DN  &kp ENTER  &kp BACKSPACE                   &kp DOWN_ARROW  &kp UP_ARROW  &kp KP_DOT     &kp RBKT         &none
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
